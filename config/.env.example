# =============================================================
# Deep Research Agent — 环境配置
# =============================================================
# 复制此文件为 .env：  cp .env.example .env
# 然后填写你的 API Key

# -----------------------------------------------------------
# LangSmith 追踪（可选）
# -----------------------------------------------------------
# 开启后可在 LangSmith 查看 LangGraph 节点、LLM、Embedding、Rerank 和 Web Search trace
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 兼容旧版 LangChain/LangSmith tracing 开关
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------
# LLM Provider 配置
# -----------------------------------------------------------
# 支持的 Provider:
#   siliconflow — 硅基流动（默认，推荐） https://siliconflow.cn
#   qwen        — 阿里云百炼 https://dashscope.aliyun.com
#   openai      — OpenAI / 其他兼容接口
#
# 硅基流动注册：https://cloud.siliconflow.cn
# 新用户赠送 2000 万 token，API Key 在控制台 → API 密钥 中获取

LLM_PROVIDER=siliconflow
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=sk-your-siliconflow-api-key-here
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# 硅基流动推荐模型：
#   性价比: Qwen/Qwen3-8B (￥0.5/百万token)
#   高性能: deepseek-ai/DeepSeek-V3 (￥2/百万token)
#   轻量:   Qwen/Qwen2.5-7B-Instruct

# 切换到阿里云百炼：
#   LLM_PROVIDER=qwen
#   LLM_MODEL=qwen-plus
#   LLM_API_KEY=sk-your-dashscope-key
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 切换到 OpenAI：
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-your-openai-key

# -----------------------------------------------------------
# Embedding 配置
# -----------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_MAX_CHARS=500

# -----------------------------------------------------------
# Milvus / Zilliz Cloud 向量数据库（可选，默认使用 Chroma）
# -----------------------------------------------------------
# 使用 Zilliz Cloud（推荐）: 在 https://zilliz.com 注册获取 URI + Token
#   MILVUS_URI=https://in03-xxxx.api.vectordb.zillizcloud.com
#   MILVUS_TOKEN=your-zilliz-api-token
#
# 使用自建 Milvus:
#   MILVUS_HOST=localhost
#   MILVUS_PORT=19530
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=
MILVUS_TOKEN=

# -----------------------------------------------------------
# Chroma 向量数据库（默认）
# -----------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma_db

# -----------------------------------------------------------
# 检索参数
# -----------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_RETRIES=3
RETRIEVAL_CRITIQUE_THRESHOLD=0.6
RETRIEVAL_VECTOR_BACKEND=chroma

# -----------------------------------------------------------
# 多跳推理
# -----------------------------------------------------------
REASONING_ENABLED=true
REASONING_MAX_HOPS=3
REASONING_CONTEXT_MAX_CHARS=3000
REASONING_SEARCH_QUERY_MAX_CHARS=400

# -----------------------------------------------------------
# Rerank 二阶段精排（可选，默认关闭以避免额外费用）
# -----------------------------------------------------------
# 使用硅基流动 Qwen/Qwen3-Reranker-8B 对粗排候选结果做相关性重排。
# RERANK_API_KEY 留空时会复用 LLM_API_KEY，其次复用 EMBEDDING_API_KEY。
RERANK_ENABLED=false
RERANK_PROVIDER=siliconflow
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_TOP_N=5
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_TIMEOUT=30
RERANK_INSTRUCTION=请根据查询内容判断文档与查询的相关性，并按相关性从高到低排序。

# ────────── MCP Web Search ──────────
# 启用 Web Search：在 Tavily 注册获取 API Key (https://tavily.com)
# 免费额度 1000 次/月，足以进行开发和演示
MCP_WEB_SEARCH_ENABLED=false
MCP_TAVILY_API_KEY=
MCP_TAVILY_MAX_RESULTS=5
