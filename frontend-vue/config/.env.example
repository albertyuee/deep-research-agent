# Deep Research Agent — 环境配置
# 如果你还没有 API Key，去 https://cloud.siliconflow.cn 免费注册获取

LLM_PROVIDER=siliconflow
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODE=api
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_DEVICE=cpu

MILVUS_HOST=localhost
MILVUS_PORT=19530

CHROMA_PERSIST_DIR=./data/chroma_db

RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_RETRIES=3
RETRIEVAL_CRITIQUE_THRESHOLD=0.6
RETRIEVAL_VECTOR_BACKEND=chroma
